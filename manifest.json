{
  "id": "milestones",
  "contexts": [
    "household",
    "shared_space"
  ],
  "name": "Milestones",
  "version": "1.0.0",
  "description": "The firsts and the once-evers — first steps, first word, first day of school, the day the dog came home, the day we got the keys. Each one keeps its date, who it was about, and how old they were, on a timeline that only ever grows.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "milestones",
    "firsts",
    "memories",
    "kids",
    "timeline",
    "family"
  ],
  "icon": "🌱",
  "nav": {
    "label": "Milestones"
  },
  "data_access": {
    "reads": [
      "family.members",
      "family.preferences"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": [
    "date_precision"
  ],
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT m.title AS title, CASE WHEN COUNT(p.id) = 0 THEN 'Our household' WHEN COUNT(p.id) > 1 THEN 'Household members' WHEN MAX(p.member_id) <> '' THEN 'Household member' ELSE MAX(p.name) END AS subtitle, m.occurred_date AS at FROM app_milestones__milestones m LEFT JOIN app_milestones__milestone_people mp ON mp.milestone_id = m.id LEFT JOIN app_milestones__people p ON p.id = mp.person_id AND p.archived_at IS NULL WHERE m.date_precision = 'day' AND substr(m.occurred_date, 6, 5) = substr(:today, 6, 5) AND m.occurred_date < :today GROUP BY m.id, m.title, m.occurred_date HAVING COUNT(mp.id) = 0 OR COUNT(p.id) > 0 ORDER BY m.occurred_date DESC LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "subtitle": "subtitle",
      "when": "at",
      "empty_hides": true
    }
  },
  "row_policies": {
    "people": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "adult_values": [
        "everyone",
        "private"
      ],
      "insert_privileged_only": false,
      "delete_adult_only": true,
      "column_write_acls": {
        "archived_at": {
          "writable_by": [
            "adult"
          ]
        }
      },
      "max_rows": 200
    },
    "milestones": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "adult_values": [
        "everyone",
        "private"
      ],
      "delete_adult_only": true,
      "max_rows": 5000
    },
    "milestone_people": {
      "kind": "inherit_visibility",
      "parent_table": "milestones",
      "fk_column": "milestone_id",
      "writer_column": "written_by",
      "max_rows": 20000
    }
  },
  "member_references": {
    "people": [
      {
        "column": "created_by",
        "on_removed": "keep"
      },
      {
        "column": "member_id",
        "on_removed": "keep"
      }
    ],
    "milestones": [
      {
        "column": "created_by",
        "on_removed": "keep"
      }
    ],
    "milestone_people": [
      {
        "column": "written_by",
        "on_removed": "keep"
      }
    ]
  },
  "delete_file_list_columns": {
    "milestones": [
      "file_ids"
    ]
  },
  "update_file_list_columns": {
    "milestones": [
      "file_ids"
    ]
  },
  "delete_cascades": {
    "milestones": [
      {
        "table": "milestone_people",
        "foreign_key": "milestone_id"
      }
    ],
    "people": [
      {
        "table": "milestone_people",
        "foreign_key": "person_id"
      }
    ]
  },
  "publishes": [
    "milestones.recorded"
  ],
  "publish_acls": {
    "milestones.recorded": {
      "require_role": "member"
    }
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "milestone_timeline"
    ]
  },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_file_bytes": 20971520,
    "max_files_bytes": 1073741824
  }
}
