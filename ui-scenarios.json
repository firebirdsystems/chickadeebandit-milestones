{
  "scenarios": [
    {
      "name": "the Remove control on a milestone renders for an adult and not for a child",
      "members": { "parent": "adult", "kid": "child" },
      "steps": [
        { "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__milestones (id, title, category, occurred_date, visibility, created_by, created_at, updated_at) VALUES ('ms-entry', ?, 'first', '2026-05-04', 'everyone', ?, '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": ["First swim lesson", "{{parent}}"] },

        { "action": "open", "as": "kid" },
        { "action": "expectVisible", "as": "kid", "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"ms-entry\"]" },
        { "action": "expectCount", "as": "kid", "selector": "[data-testid=\"milestone-remove\"][data-milestone-id=\"ms-entry\"]", "count": 0 },
        { "action": "expectText", "as": "kid", "text": "First swim lesson" },

        { "action": "open", "as": "parent" },
        { "action": "expectVisible", "as": "parent", "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"ms-entry\"]" },
        { "action": "expectVisible", "as": "parent", "selector": "[data-testid=\"milestone-remove\"][data-milestone-id=\"ms-entry\"]" }
      ]
    },
    {
      "name": "in a shared space a participant may edit, remove, restore and detach only what they added themselves; the steward may for everyone's",
      "context": "shared_space",
      "members": {
        "steward": "admin",
        "pat": "adult",
        "sam": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__people (id, name, visibility, archived_at, created_by, created_at, updated_at) VALUES (?, ?, 'everyone', ?, ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "sp-p-sam",
            "Juniper",
            null,
            "{{sam}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__people (id, name, visibility, archived_at, created_by, created_at, updated_at) VALUES (?, ?, 'everyone', ?, ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "sp-p-pat",
            "Rowan",
            null,
            "{{pat}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__people (id, name, visibility, archived_at, created_by, created_at, updated_at) VALUES (?, ?, 'everyone', ?, ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "sp-p-sam-old",
            "Bramble",
            "2026-01-04T00:00:00Z",
            "{{sam}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__people (id, name, visibility, archived_at, created_by, created_at, updated_at) VALUES (?, ?, 'everyone', ?, ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "sp-p-pat-old",
            "Thistle",
            "2026-01-04T00:00:00Z",
            "{{pat}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__milestones (id, title, category, occurred_date, visibility, created_by, created_at, updated_at) VALUES (?, ?, 'first', ?, 'everyone', ?, '2026-01-02T00:00:00Z', '2026-01-02T00:00:00Z')",
          "params": [
            "sp-m-sam",
            "First recital",
            "2024-03-10",
            "{{sam}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__milestones (id, title, category, occurred_date, visibility, created_by, created_at, updated_at) VALUES (?, ?, 'first', ?, 'everyone', ?, '2026-01-02T00:00:00Z', '2026-01-02T00:00:00Z')",
          "params": [
            "sp-m-pat",
            "First bike ride",
            "2024-05-20",
            "{{pat}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__milestone_people (id, milestone_id, person_id, written_by, created_at) VALUES (?, ?, ?, ?, '2026-01-03T00:00:00Z')",
          "params": [
            "sp-l-sam",
            "sp-m-sam",
            "sp-p-sam",
            "{{sam}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_milestones__milestone_people (id, milestone_id, person_id, written_by, created_at) VALUES (?, ?, ?, ?, '2026-01-03T00:00:00Z')",
          "params": [
            "sp-l-pat",
            "sp-m-pat",
            "sp-p-sam",
            "{{steward}}"
          ]
        },
        {
          "action": "open",
          "as": "pat"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"sp-m-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"milestone-edit\"][data-milestone-id=\"sp-m-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"milestone-edit\"]",
          "count": 1
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"milestone-remove\"][data-milestone-id=\"sp-m-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"milestone-remove\"]",
          "count": 1
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"person-edit\"][data-person-id=\"sp-p-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"person-edit\"]",
          "count": 1
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"archived-people\"]"
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"person-restore\"][data-person-id=\"sp-p-pat-old\"]",
          "count": 1
        },
        {
          "action": "expectCount",
          "as": "pat",
          "selector": "[data-testid=\"person-restore\"]",
          "count": 1
        },
        {
          "action": "click",
          "as": "pat",
          "selector": "[data-testid=\"milestone-edit\"][data-milestone-id=\"sp-m-pat\"]"
        },
        {
          "action": "expectVisible",
          "as": "pat",
          "selector": "[data-testid=\"milestone-form\"]"
        },
        {
          "action": "click",
          "as": "pat",
          "selector": "[data-testid=\"person-option\"][data-person-id=\"sp-p-sam\"]"
        },
        {
          "action": "click",
          "as": "pat",
          "selector": "[data-testid=\"milestone-save\"]"
        },
        {
          "action": "expectText",
          "as": "pat",
          "selector": "[data-testid=\"page-error\"]",
          "text": "Ask them or the steward to change that."
        },
        {
          "action": "open",
          "as": "steward"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"sp-m-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"milestone-edit\"][data-milestone-id=\"sp-m-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"milestone-edit\"]",
          "count": 2
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"milestone-remove\"][data-milestone-id=\"sp-m-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"milestone-remove\"]",
          "count": 2
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"person-edit\"][data-person-id=\"sp-p-pat\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"person-edit\"]",
          "count": 2
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"archived-people\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"person-restore\"][data-person-id=\"sp-p-pat-old\"]",
          "count": 1
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"person-restore\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "as": "steward",
          "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"sp-m-sam\"]",
          "text": "Juniper"
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"milestone-edit\"][data-milestone-id=\"sp-m-sam\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"milestone-form\"]"
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"person-option\"][data-person-id=\"sp-p-sam\"]"
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"milestone-save\"]"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"milestone-form\"]",
          "count": 0
        },
        {
          "action": "expectNoText",
          "as": "steward",
          "selector": "[data-testid=\"milestone-entry\"][data-milestone-id=\"sp-m-sam\"]",
          "text": "Juniper"
        },
        {
          "action": "expectCount",
          "as": "steward",
          "selector": "[data-testid=\"page-error\"]",
          "count": 0
        }
      ]
    }
  ]
}
